# ===== LLM 配置 =====
# 默认使用智谱 GLM-4-Flash（注册 https://open.bigmodel.cn 后在「API Keys」页面创建）
# 不填 LLM_API_KEY 时自动使用内置模拟模式（离线开发/答辩断网兜底）
LLM_API_KEY=74688549dfc74dc0b720c5c94a081332.ocpNsNUHxH8QXK7x

LLM_MODEL=glm-4-flash
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ===== 数据库 =====
# 开发默认 SQLite（零配置）。部署到 MySQL 时改为：
# DATABASE_URL=mysql+pymysql://root:你的密码@localhost:3306/mbti?charset=utf8mb4
DATABASE_URL=sqlite:///./mbti.db

# ===== 其他 =====
JWT_SECRET=change-me-in-production
